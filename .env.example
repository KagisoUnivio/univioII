# Documentation only: the application reads the process environment, not this file.
# Supply the real Meta values and independently generate the two application tokens.
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
API_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_ACCESS_TOKEN=
APP_ENV=development
# Production requires DATABASE_URL and a mounted AWS RDS CA bundle.
DATABASE_URL=
DATABASE_CA_FILE=
# Separate DDL credential for the explicit migration command; never inject into API/worker.
MIGRATION_DATABASE_URL=
# Enable intake only after private S3, malware scans and retention are configured.
DOCUMENT_BUCKET=
DOCUMENT_OWNER_SECRET=
# Set the same independent 32+ character value for the API and worker.
MATCHING_PROFILE_SECRET=
